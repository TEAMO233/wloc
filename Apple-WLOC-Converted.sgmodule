#!name=Apple WLOC 定位修改 (Surge 备份转换版)
#!desc=Apple 网络定位响应修改 | 默认透传；通过设置接口或修改 argument 设置目标坐标 | 原作者 Yu9191 Rewrite
#!author=Yu9191 Rewrite（Surge 兼容适配）

# 此模块需与下方两个 JS 文件一起上传到 TEAMO233/wloc 仓库 main 分支根目录。
# longitude/latitude 为原插件默认占位坐标；无持久化设置时不会修改位置。
# 如需固定坐标，可直接修改下方 argument 的 longitude 与 latitude。
# 通过 wloc-settings/save 保存的坐标会覆盖 argument。

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=true,binary-body-mode=true,timeout=30,script-path=https://raw.githubusercontent.com/TEAMO233/wloc/main/wloc-surge-converted.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/wloc-settings\/save,timeout=10,script-path=https://raw.githubusercontent.com/TEAMO233/wloc/main/wloc-settings-converted.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
